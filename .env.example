# MongoDB Atlas connection
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/utms?retryWrites=true&w=majority"
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Faculty accounts can only register with this code
FACULTY_INVITE_CODE="change-me"
# Local file storage root (outside /public so files are never served directly)
STORAGE_DIR="./storage"
